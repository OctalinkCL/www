---
import OctalinkLogo from "../../assets/octalink.svg";

const navLinks = [
  { href: "#como-funciona", label: "Cómo funciona" },
  { href: "#planes", label: "Planes" },
  { href: "#casos", label: "Casos" },
  { href: "#faq", label: "FAQ" },
];
---

<footer class="bg-ink-950 border-t border-white/10 py-14">
  <div class="wrapper flex flex-col items-center text-center gap-6">
    <a href="/" class="inline-block">
      <img src={OctalinkLogo.src} alt="Octalink" class="h-7" />
    </a>

    <p class="text-sm text-white/50">
      Octalink SpA · Concepción, Chile ·{" "}
      <a href="mailto:hola@octalink.cl" class="hover:text-white transition-colors">
        hola@octalink.cl
      </a>{" "}
      ·{" "}
      <a href="/" class="hover:text-white transition-colors">
        octalink.cl
      </a>
    </p>

    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-white/50">
      {
        navLinks.map((link, index) => (
          <>
            {index > 0 && <span class="text-white/20">·</span>}
            <a href={link.href} class="hover:text-white transition-colors">
              {link.label}
            </a>
          </>
        ))
      }
    </nav>

    <div class="h-px w-full max-w-xs bg-white/10"></div>

    <p class="text-sm text-white/40">© 2026 Octalink SpA. Todos los derechos reservados.</p>
  </div>
</footer>
