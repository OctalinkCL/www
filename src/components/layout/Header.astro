---
// import { MessageCircle } from "@lucide/astro";
import LogoIcon from "../LogoIcon.astro";

const items = [
  { href: "#como-funciona", label: "Como" },
  { href: "#planes", label: "Planes" },
  { href: "#casos", label: "Casos" },
  { href: "#faq", label: "FAQ" },
];

const ctaLink =
  "https://wa.me/56932393772?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20de%20Octalink.";
---

<header
  id="site-header"
  class="group fixed inset-x-0 top-0 z-50 transition-all duration-300 ease-in-out | [&.hs]:bg-neutral-950"
>
  <!-- header | group-[.hs]:py-3.5 -->
  <div
    class="container max-w-330 mx-auto px-5 py-6 transition-all duration-500 ease-in-out | lg:px-0 lg:py-12 lg:group-[.hs]:py-9 flex items-center justify-between"
  >
    <!-- logo | group-[.hs]:text-neutral-800 -->
    <a href="/" class="flex items-center gap-2 text-white w-45">
      <!-- | group-[.hs]:size-5 -->
      <LogoIcon
        class="size-8 transition-all duration-500 ease-in-out | group-[.hs]:rotate-180 group-[.hs]:text-primary"
      />
      <!-- | group-[.hs]:text-2xl -->
      <span class="text-3xl font-light transition-all duration-500 ease-in-out">
        OCTALINK
      </span>
    </a>

    <!-- navigation -->
    <nav
      class="hidden text-neutral-500 font-mono text-xs uppercase gap-10 lg:flex"
    >
      {
        items.map((item) => (
          <a
            href={item.href}
            class="px-2.5 py-1.5 hover:bg-white/10 hover:text-white rounded-sm transition-colors"
            aria-label={item.label}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- cta -->
    <div class="hidden lg:block">
      <a
        href={ctaLink}
        class="lg:w-45 btn btn-primary"
        aria-label="Start a project"
        target="_blank"
      >
        <span>Start a project</span>
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => header?.classList.toggle("hs", window.scrollY > 450);

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
