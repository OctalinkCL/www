---
import LogoIcon from "../LogoIcon.astro";

const items = [
  { href: "#", label: "Inicio" },
  { href: "#como-funciona", label: "Cómo" },
  { href: "#casos", label: "Casos" },
  { href: "#planes", label: "Planes" },
  { href: "#faq", label: "FAQ" },
];

const cta = {
  text: "Iniciar proyecto",
  mobileText: "Hablemos",
  href:
    "https://wa.me/56932393772?text=" +
    encodeURIComponent("Hola, quiero iniciar un proyecto con Octalink."),
};
---

<header
  id="site-header"
  class="group fixed inset-x-0 top-0 z-50 transition-all duration-300 ease-in-out | [&.hs]:bg-neutral-950"
>
  <!-- header | group-[.hs]:py-3.5 -->
  <div
    class="container max-w-330 mx-auto px-5 py-6 transition-all duration-500 ease-in-out | lg:px-8 min-[1400px]:px-0 lg:py-12 lg:group-[.hs]:py-9 flex items-center justify-between"
  >
    <!-- logo | group-[.hs]:text-neutral-800 -->
    <a href="/" class="flex items-center gap-2 text-white w-45">
      <!-- | group-[.hs]:size-5 -->
      <LogoIcon
        class="size-8 transition-all duration-500 ease-in-out | group-[.hs]:rotate-180 group-[.hs]:text-primary"
      />
      <!-- | group-[.hs]:text-2xl -->
      <span class="text-3xl font-light transition-all duration-500 ease-in-out">
        OCTALINK
      </span>
    </a>

    <!-- navigation -->
    <nav
      class="hidden text-neutral-400 font-mono text-xs uppercase gap-10 lg:flex"
    >
      {
        items.map((item) => (
          <a
            href={item.href}
            class="px-2.5 py-1.5 hover:bg-white/10 hover:text-white rounded-sm transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- cta -->
    <div>
      <a
        href={cta.href}
        class="btn btn-primary px-3.5 text-xs | lg:w-45 lg:px-5 lg:text-sm"
        target="_blank"
        rel="noopener"
      >
        <!-- en móvil no hay menú: el botón queda como único acceso directo -->
        <span class="lg:hidden">{cta.mobileText}</span>
        <span class="hidden lg:inline">{cta.text}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const hero = document.getElementById("section-hero");
  // en pantallas bajas el hero termina antes de los 450px
  const limit = () =>
    Math.min(450, (hero?.offsetHeight ?? 450) - (header?.offsetHeight ?? 0));
  const onScroll = () =>
    header?.classList.toggle("hs", window.scrollY > limit());

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
