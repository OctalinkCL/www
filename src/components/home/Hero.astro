---

---

<section id="section-hero" class="h-svh min-h-160">
  <div class="bg-neutral-950 size-full relative overflow-hidden">
    <!-- multimedia -->
    <div class="absolute inset-0">
      <img
        src="/assets/cover_mobile_o.webp"
        alt=""
        width="1080"
        height="1920"
        fetchpriority="high"
        class="size-full object-cover opacity-40 lg:hidden"
      />
      <!-- el video solo se carga en escritorio (ver script) -->
      <video
        class="hidden lg:block size-full object-cover opacity-40"
        data-hero-video
        data-src="/assets/video.webm"
        data-poster="/assets/cover_o.webp"
        autoplay
        muted
        loop
        playsinline></video>
    </div>
    <!-- overlay -->
    <div class="absolute inset-0 bg-neutral-900 opacity-50"></div>
    <!-- content -->
    <div
      class="relative size-full text-white flex flex-col justify-end px-5 pb-10 gap-10 | lg:container lg:mx-auto lg:max-w-330 lg:px-8 min-[1400px]:px-0 lg:pb-30"
    >
      <!-- first -->
      <div class="flex flex-col gap-6 | lg:flex-row justify-between">
        <h1 class="text-4xl lg:w-175 lg:text-6xl" data-reveal>
          Tú llevas el negocio. Nosotros llevamos la tecnología.
        </h1>
        <div class="flex flex-col gap-5 | lg:w-90 lg:justify-end lg:gap-8">
          <p class="font-mono text-xs text-orange-200/90 hidden lg:block" data-reveal>
            / WEB POR SUSCRIPCIÓN PARA PYMES
          </p>
          <p class="text-sm" data-reveal>
            Una cuota mensual fija que incluye todo. Sin agencias que
            desaparecen, sin proveedores separados.
          </p>
          <div class="flex gap-4" data-reveal>
            <a href="#planes" class="btn btn-primary">Ver planes</a>
            <a
              href="https://wa.me/56932393772?text=Hola%2C%20quiero%20agendar%20una%20llamada%20de%2015%20minutos."
              target="_blank"
              rel="noopener"
              class="btn btn-white"
            >
              Agenda una llamada
            </a>
          </div>
        </div>
      </div>
      <p class="font-mono text-[10px]" data-reveal>
        NOSOTROS DE LA TECNOLOGÍA. TÚ DE TU NEGOCIO.
      </p>
    </div>
  </div>
</section>

<script>
  // Carga el video solo en escritorio: en móvil no se descarga
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (video && window.matchMedia("(min-width: 1024px)").matches) {
    video.poster = video.dataset.poster ?? "";
    video.src = video.dataset.src ?? "";
  }
</script>
