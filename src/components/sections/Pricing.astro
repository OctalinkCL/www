---
import { Check, Calendar } from "@lucide/astro";

const plans = [
  {
    name: "Presencia",
    price: "120",
    setup: "Setup mes 1: $200 USD",
    featured: false,
    features: [
      "Hasta 4 páginas web",
      "Dominio .cl + Hosting + SSL",
      "1 correo corporativo",
      "Soporte WhatsApp — respuesta en 48h",
    ],
  },
  {
    name: "Negocio",
    price: "180",
    setup: "Setup mes 1: $350 USD",
    featured: true,
    features: [
      "Hasta 8 páginas web",
      "Hasta 3 correos corporativos",
      "Galería, catálogo y estadísticas",
      "Soporte WhatsApp — respuesta en 24h",
    ],
  },
];
---

<section id="planes" class="bg-paper-dim">
  <div class="wrapper py-20 md:py-28">
    <div class="max-w-2xl mb-14 md:mb-16">
      <span class="eyebrow mb-5">Planes y precios</span>
      <h2 class="section-title text-ink-950">Simple y transparente. Sin sorpresas.</h2>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,280px)_1fr] gap-8 lg:gap-10">
      <!-- CTA lateral -->
      <div class="lg:pt-2">
        <h3 class="text-xl font-semibold text-ink-950 mb-3">
          Agenda una llamada de 15 minutos
        </h3>
        <p class="text-ink-950/60 leading-relaxed mb-6">
          Nos presentamos, entendemos tu negocio y te decimos si podemos ayudarte.
        </p>
        <a
          href="https://wa.me/56932393772?text=Hola%2C%20quiero%20agendar%20una%20llamada%20de%2015%20minutos."
          target="_blank"
          rel="noopener"
          class="btn-outline"
        >
          <Calendar size={16} />
          <span>Agendar llamada</span>
        </a>
      </div>

      <!-- Tarjetas de planes -->
      <div class="grid sm:grid-cols-2 gap-6">
        {
          plans.map((plan) => (
            <div
              class={
                plan.featured
                  ? "relative rounded-2xl bg-paper-card border-2 border-accent p-6 md:p-8 shadow-[0_20px_40px_-20px_rgba(255,94,35,0.35)]"
                  : "card-light"
              }
            >
              {plan.featured && (
                <span class="absolute -top-3 left-6 bg-accent text-white text-xs font-semibold uppercase tracking-wide px-3 py-1 rounded-full">
                  Recomendado
                </span>
              )}

              <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-950/50 mb-4">
                Plan {plan.name}
              </h3>

              <div class="mb-1">
                <span class={`text-4xl font-bold tracking-tightest ${plan.featured ? "text-accent" : "text-ink-950"}`}>
                  ${plan.price}
                </span>
                <span class="text-ink-950/50 text-sm"> USD/mes</span>
              </div>
              <p class="text-xs text-ink-950/40 mb-6">{plan.setup}</p>

              <ul class="space-y-3 mb-8">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3 text-sm text-ink-950/75">
                    <Check size={16} class="text-accent shrink-0 mt-0.5" />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>

              <a
                href={`https://wa.me/56932393772?text=Hola%2C%20quiero%20elegir%20el%20Plan%20${plan.name}.`}
                target="_blank"
                rel="noopener"
                class={plan.featured ? "btn-primary w-full" : "btn-outline w-full"}
              >
                Elegir {plan.name}
              </a>
            </div>
          ))
        }
      </div>
    </div>

    <p class="text-center text-sm text-ink-950/45 mt-12 max-w-xl mx-auto">
      Sin contrato de permanencia — 30 días de aviso para cancelar. Al cancelar, te
      llevas tu dominio y contenido.
    </p>
  </div>
</section>
