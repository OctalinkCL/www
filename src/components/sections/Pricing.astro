---
import { ArrowRight } from "@lucide/astro";

const whatsapp = "https://wa.me/56932393772?text=";
const tag = "/ planes y precios";
const title = "Simple y transparente.";
const subtitle = "Sin sorpresas.";
const description =
  "Dos planes de sitio web para pymes. Web, hosting, dominio, correo y soporte en una sola cuota mensual — sin cobros extra.";
const note = "Precios en pesos chilenos, cuota mensual fija";
const featuredLabel = "Recomendado";
const plans = [
  {
    name: "Presencia",
    price: "$129.000",
    period: "al mes",
    description:
      "Para empresas que necesitan estar en internet de forma profesional, sin complicarse.",
    featured: false,
    features: [
      "Hasta 4 páginas web",
      "Dominio .cl + Hosting + SSL",
      "1 correo corporativo",
      "Soporte WhatsApp — respuesta en 48h",
    ],
    cta: "Elegir Presencia",
    message: "Hola, quiero elegir el Plan Presencia.",
  },
  {
    name: "Negocio",
    price: "$199.000",
    period: "al mes",
    description:
      "Para empresas que muestran sus productos o servicios en la web y necesitan más páginas, correos y respuesta más rápida.",
    featured: true,
    features: [
      "Hasta 8 páginas web",
      "Hasta 3 correos corporativos",
      "Galería, catálogo y estadísticas",
      "Soporte WhatsApp — respuesta en 24h",
    ],
    cta: "Elegir Negocio",
    message: "Hola, quiero elegir el Plan Negocio.",
  },
];
const custom = {
  name: "A medida",
  description:
    "¿Necesitas más páginas, integraciones o algo distinto? Armamos un plan a la medida de tu empresa.",
  cta: "Cotizar a medida",
  message: "Hola, quiero cotizar un plan a medida.",
};
const call = {
  title: "¿No sabes cuál elegir?",
  description:
    "Agenda una llamada de 15 minutos. Nos presentamos, entendemos tu negocio y te decimos si podemos ayudarte.",
  cta: "Agendar llamada",
  message: "Hola, quiero agendar una llamada de 15 minutos.",
};
const terms = [
  "Sin contrato de permanencia — 30 días de aviso para cancelar. Al cancelar, te llevas tu dominio y contenido.",
  "* Proyectos con integraciones, sistemas a medida o funcionalidades avanzadas pueden tener un costo de implementación según el alcance.",
];
---

<section id="planes" class="bg-neutral-100 lg:scroll-mt-12">
  <div
    class="container mx-auto px-5 py-24 lg:max-w-330 lg:px-8 min-[1400px]:px-0"
  >
    <!-- header -->
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-9 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <span class="font-mono text-neutral-600 text-xs uppercase">{tag}</span>
        <h2 class="text-4xl mt-3 lg:text-5xl lg:mt-10">
          {title}
          <span class="block text-neutral-500">{subtitle}</span>
        </h2>
      </div>
      <div class="lg:col-start-9 lg:col-span-4" data-reveal>
        <p class="text-neutral-600">{description}</p>
        <span class="block mt-4 font-mono text-neutral-600 text-xs uppercase">
          {note}
        </span>
      </div>
    </div>

    <!-- plans -->
    <ul class="mt-10 grid gap-3 lg:grid-cols-2 lg:mt-16">
      {
        plans.map((plan) => (
          <li
            data-reveal
            class:list={[
              "p-6 bg-white rounded-xl border flex flex-col lg:p-10",
              plan.featured ? "border-primary" : "border-neutral-200",
            ]}
          >
            <div class="flex items-center justify-between gap-4 min-h-7">
              <h3 class="flex items-center gap-2 font-mono text-xs uppercase font-medium">
                <span class="size-1.5 rounded-full bg-primary" />
                {plan.name}
              </h3>
              {plan.featured && (
                <span class="font-mono text-xs uppercase bg-primary text-neutral-950 rounded-full px-3 py-1">
                  {featuredLabel}
                </span>
              )}
            </div>

            <div class="mt-10 text-5xl lg:text-6xl">{plan.price}</div>
            <div class="mt-3 font-mono text-xs uppercase text-neutral-500">
              {plan.period}
            </div>

            <p class="mt-8 text-neutral-600 max-w-md">{plan.description}</p>

            <ul class="mt-8 mb-10 border-t border-neutral-200 pt-8 flex flex-col gap-4">
              {plan.features.map((feature) => (
                <li class="flex items-baseline gap-4">
                  <span class="size-1 shrink-0 rounded-full bg-primary -translate-y-1" />
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href={whatsapp + encodeURIComponent(plan.message)}
              target="_blank"
              rel="noopener"
              class:list={[
                "btn mt-auto py-3",
                plan.featured
                  ? "bg-primary text-neutral-950 hover:bg-neutral-900 hover:text-white"
                  : "bg-neutral-900 text-white hover:bg-primary hover:text-neutral-950",
              ]}
            >
              {plan.cta}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- custom -->
    <div
      data-reveal
      class="mt-3 px-6 py-5 bg-white rounded-xl border border-neutral-200 flex flex-col gap-4 lg:px-10 lg:flex-row lg:items-center lg:gap-9"
    >
      <h3
        class="flex items-center gap-2 shrink-0 font-mono text-xs uppercase font-medium"
      >
        <span class="size-1.5 rounded-full bg-primary"></span>
        {custom.name}
      </h3>
      <p class="text-neutral-600 lg:flex-1">{custom.description}</p>
      <a
        href={whatsapp + encodeURIComponent(custom.message)}
        target="_blank"
        rel="noopener"
        class="shrink-0 inline-flex items-center gap-3 font-mono text-sm font-medium uppercase transition-colors duration-300 hover:text-primary"
      >
        {custom.cta}
        <ArrowRight class="text-primary size-5" stroke-width={1} />
      </a>
    </div>

    <!-- call -->
    <div
      data-reveal
      class="mt-10 border-t border-neutral-200 pt-8 grid gap-8 lg:grid-cols-12 lg:gap-9 lg:mt-16"
    >
      <div class="lg:col-span-5">
        <h3 class="text-2xl">{call.title}</h3>
        <p class="mt-2 text-neutral-600">{call.description}</p>
        <a
          href={whatsapp + encodeURIComponent(call.message)}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center gap-3 font-mono text-sm font-medium uppercase transition-colors duration-300 hover:text-primary"
        >
          {call.cta}
          <ArrowRight class="text-primary size-5" stroke-width={1} />
        </a>
      </div>
      <div class="flex flex-col gap-3 text-sm text-neutral-600 lg:col-start-9 lg:col-span-4">
        {terms.map((term) => <p>{term}</p>)}
      </div>
    </div>
  </div>
</section>
