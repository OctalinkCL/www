---
import { Clock, Boxes, RefreshCw } from "@lucide/astro";
---

<section class="bg-paper">
  <div class="wrapper py-20 md:py-28">
    <div class="max-w-2xl mb-14 md:mb-16">
      <h2 class="section-title text-ink-950">
        Pagaste por una web. Nadie te dijo quién se hace cargo de que funcione.
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <!-- Punto 1 — destacado -->
      <div class="rounded-2xl bg-ink-950 p-8 md:p-10 flex flex-col justify-between min-h-72">
        <Clock size={28} class="text-accent" />
        <p class="text-2xl md:text-3xl font-medium text-white leading-snug mt-10">
          Nadie contesta cuando algo falla a las 3 de la mañana.
        </p>
      </div>

      <!-- Puntos 2 y 3 -->
      <div class="flex flex-col gap-6">
        <div class="card-light flex-1 flex items-start gap-4">
          <Boxes size={22} class="text-accent shrink-0 mt-0.5" />
          <p class="text-base md:text-lg text-ink-950/80 leading-relaxed">
            Gestionas hosting, dominio y correo con tres proveedores distintos.
          </p>
        </div>
        <div class="card-light flex-1 flex items-start gap-4">
          <RefreshCw size={22} class="text-accent shrink-0 mt-0.5" />
          <p class="text-base md:text-lg text-ink-950/80 leading-relaxed">
            El diseño envejece y nadie lo actualiza.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
