---
const tag = "/ HUSTON TENEMOS UN PROBLEMA";
const title =
  "Pagaste por una web. Nadie te dijo quién se hace cargo de que funcione.";
const items = [
  {
    title: "Quien ayuda",
    description: "Nadie contesta cuando algo falla el fin de semana.",
  },
  {
    title: "Quien gestiona",
    description: "Hosting, dominio y correo con tres proveedores distintos.",
  },
  {
    title: "Quien actualiza",
    description: "El diseño envejece y nadie lo actualiza.",
  },
];
---

<section>
  <div
    class="container grid gap-3 mx-auto px-4 py-24 lg:max-w-330 lg:px-0 lg:grid-cols-3"
  >
    <!-- tag -->
    <div class="font-mono text-neutral-400 text-xs">{tag}</div>
    <!-- description -->
    <div class="lg:col-span-2 flex flex-col gap-12">
      <h3 class="text-4xl">{title}</h3>

      <div class="grid gap-3 lg:grid-cols-3">
        <!-- item -->
        {
          items.map((item, index) => (
            <div class="p-6 shadow-2xl shadow-neutral-200/60 bg-white rounded-xl flex flex-col min-h-50 lg:min-h-70">
              <span class="font-mono text-xs text-neutral-500">
                0{index + 1}
              </span>
              <h4 class="mt-auto text-2xl mb-3">{item.title}</h4>
              <p class="text-neutral-600">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
