---
import { Plus, ArrowRight } from "@lucide/astro";

const tag = "/ preguntas frecuentes";
const title = "Antes de escribirnos.";
const subtitle = "Lo que casi todos nos preguntan.";
const contact = {
  text: "¿Otra duda? Escríbenos",
  href: "https://wa.me/56932393772?text=" + encodeURIComponent("Hola, tengo una duda."),
};
const faqs = [
  {
    question: "¿Qué incluye la suscripción?",
    answer:
      "Todo lo necesario para que tu web funcione: diseño y desarrollo del sitio, hosting, dominio .cl, correo corporativo, certificado de seguridad, actualizaciones y soporte 24/7 por WhatsApp. Sin cobros extra.",
  },
  {
    question: "¿Por qué una suscripción y no un pago único?",
    answer:
      "Porque una web no se entrega y se olvida: hay que mantenerla. Con el pago único, cuando algo falla o envejece quedas solo. Con la suscripción, que funcione siempre es responsabilidad nuestra.",
  },
  {
    question: "Ya tengo una web y un dominio. ¿Qué pasa con ellos?",
    answer:
      "Tu dominio sigue siendo tuyo. Revisamos tu web actual contigo y definimos si conviene mejorarla o rehacerla. En ambos casos nos hacemos cargo de que esté activa, actualizada y funcionando.",
  },
  {
    question: "No tengo web, solo redes sociales. ¿Me sirve?",
    answer:
      "Sí. Partimos de cero: registramos tu dominio .cl, diseñamos tu sitio y creamos tu correo corporativo. Tú solo nos cuentas de tu negocio.",
  },
  {
    question: "¿Cuánto demora tener mi sitio listo?",
    answer:
      "Entre 2 y 3 semanas desde que conversamos y tenemos la información de tu empresa.",
  },
  {
    question: "¿Qué pasa si algo falla o necesito un cambio?",
    answer:
      "Nos escribes por WhatsApp, cualquier día y a cualquier hora. Te respondemos en menos de 24 o 48 horas según tu plan, y los cambios los hacemos nosotros.",
  },
  {
    question: "¿Hay contrato? ¿Qué pasa si quiero cancelar?",
    answer:
      "No hay contrato de permanencia. Avisas con 30 días de anticipación y listo: te llevas tu dominio y tu contenido.",
  },
];
---

<section id="faq" class="bg-white lg:scroll-mt-12">
  <div
    class="container grid gap-12 mx-auto px-5 py-24 lg:max-w-330 lg:px-8 min-[1400px]:px-0 lg:grid-cols-3 lg:gap-16"
  >
    <!-- header -->
    <div class="lg:sticky lg:top-36 lg:self-start" data-reveal>
      <span class="font-mono text-neutral-500 text-xs uppercase">{tag}</span>
      <h2 class="text-4xl mt-3 lg:text-5xl lg:mt-10">
        {title}
        <span class="text-neutral-500">{subtitle}</span>
      </h2>
      <a
        href={contact.href}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex items-center gap-3 font-mono text-sm font-medium uppercase transition-colors duration-300 hover:text-primary"
      >
        {contact.text}
        <ArrowRight class="text-primary size-5" stroke-width={1} />
      </a>
    </div>

    <!-- questions -->
    <div class="lg:col-span-2 border-b border-neutral-200">
      {
        faqs.map((faq, index) => (
          <details class="group border-t border-neutral-200" data-faq data-reveal>
            <summary class="flex items-baseline gap-4 py-8 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden lg:gap-9">
              <span class="font-mono text-xs text-neutral-500">
                0{index + 1}
              </span>
              <h3 class="flex-1 text-xl transition-colors duration-300 group-hover:text-primary lg:text-2xl">
                {faq.question}
              </h3>
              <Plus
                class="size-6 shrink-0 self-center transition-transform duration-300 group-open:rotate-45 group-open:text-primary"
                stroke-width={1}
              />
            </summary>
            <p class="pb-8 pl-8 pr-10 max-w-2xl text-neutral-600 lg:pl-13">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Solo una pregunta abierta a la vez
  document.querySelectorAll("[data-faq]").forEach((faq) => {
    faq.addEventListener("toggle", (e) => {
      const target = e.target as HTMLDetailsElement;
      if (target.open) {
        document.querySelectorAll("[data-faq]").forEach((other) => {
          if (other !== target && (other as HTMLDetailsElement).open) {
            (other as HTMLDetailsElement).open = false;
          }
        });
      }
    });
  });
</script>
