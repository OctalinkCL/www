---
import { ChevronDown } from "@lucide/astro";

const faqs = [
  {
    question: "¿Ya tengo una web?",
    answer:
      "Perfecto — ¿quién se encarga de que esté siempre activa, actualizada y funcionando? Si tienes eso resuelto, no necesitas lo que hacemos. Si no, ahí es donde entramos nosotros.",
  },
  {
    question: "¿Es muy caro para lo que es?",
    answer:
      "¿Cuánto pagas hoy por hosting, dominio y correos por separado? Si sumas eso más el tiempo que le dedicas a resolver problemas, probablemente ya estás pagando más — y sin el soporte continuo.",
  },
  {
    question: "¿Por qué mensual y no un pago único?",
    answer:
      "Porque una web no es un producto, es un servicio. Como la electricidad o el internet — pagas mientras funciona. Con el pago único te venden algo que envejece y cuando algo falla, quedas solo.",
  },
  {
    question: "¿No sé si lo necesito?",
    answer:
      "¿Tu competencia tiene web y correos profesionales? Si la respuesta es sí, ya estás en desventaja. Si la respuesta es no, tienes una oportunidad.",
  },
];
---

<section id="faq" class="bg-paper">
  <div class="wrapper py-20 md:py-28">
    <div class="max-w-2xl mb-14 md:mb-16">
      <span class="eyebrow mb-5">Preguntas frecuentes</span>
      <h2 class="section-title text-ink-950">Antes de escribirnos</h2>
    </div>

    <div class="max-w-3xl space-y-3">
      {
        faqs.map((faq, index) => (
          <details class="group card-light p-0! overflow-hidden" data-faq>
            <summary class="flex items-center gap-5 p-6 cursor-pointer select-none list-none">
              <span class="text-sm font-semibold text-accent shrink-0">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="flex-1 text-lg md:text-xl font-medium text-ink-950">
                {faq.question}
              </span>
              <ChevronDown
                size={20}
                class="chevron text-ink-950/40 shrink-0 transition-transform duration-300"
              />
            </summary>
            <div class="px-6 pb-6">
              <div class="border-t border-black/6 pt-4 pl-9">
                <p class="text-ink-950/65 leading-relaxed">{faq.answer}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Solo una pregunta abierta a la vez
  document.querySelectorAll("[data-faq]").forEach((faq) => {
    faq.addEventListener("toggle", (e) => {
      const target = e.target as HTMLDetailsElement;
      if (target.open) {
        document.querySelectorAll("[data-faq]").forEach((other) => {
          if (other !== target && (other as HTMLDetailsElement).open) {
            (other as HTMLDetailsElement).open = false;
          }
        });
      }
    });
  });
</script>
