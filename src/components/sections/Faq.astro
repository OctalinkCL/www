---
import { Plus, ArrowRight } from "@lucide/astro";

const tag = "/ preguntas frecuentes";
const title = "Antes de escribirnos.";
const subtitle = "Lo que casi todos nos preguntan.";
const contact = {
  text: "¿Otra duda? Escríbenos",
  href: "https://wa.me/56932393772?text=" + encodeURIComponent("Hola, tengo una duda."),
};
const faqs = [
  {
    question: "¿Ya tengo una web?",
    answer:
      "Perfecto — ¿quién se encarga de que esté siempre activa, actualizada y funcionando? Si tienes eso resuelto, no necesitas lo que hacemos. Si no, ahí es donde entramos nosotros.",
  },
  {
    question: "¿Es muy caro para lo que es?",
    answer:
      "¿Cuánto pagas hoy por hosting, dominio y correos por separado? Si sumas eso más el tiempo que le dedicas a resolver problemas, probablemente ya estás pagando más — y sin el soporte continuo.",
  },
  {
    question: "¿Por qué mensual y no un pago único?",
    answer:
      "Porque una web no es un producto, es un servicio. Como la electricidad o el internet — pagas mientras funciona. Con el pago único te venden algo que envejece y cuando algo falla, quedas solo.",
  },
  {
    question: "¿No sé si lo necesito?",
    answer:
      "¿Tu competencia tiene web y correos profesionales? Si la respuesta es sí, ya estás en desventaja. Si la respuesta es no, tienes una oportunidad.",
  },
];
---

<section id="faq" class="bg-white">
  <div
    class="container grid gap-12 mx-auto px-4 py-24 lg:max-w-330 lg:px-0 lg:grid-cols-3 lg:gap-16"
  >
    <!-- header -->
    <div class="lg:sticky lg:top-24 lg:self-start">
      <span class="font-mono text-neutral-400 text-xs uppercase">{tag}</span>
      <h3 class="text-4xl mt-3 lg:text-5xl lg:mt-10">
        {title}
        <span class="text-neutral-400">{subtitle}</span>
      </h3>
      <a
        href={contact.href}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex items-center gap-3 font-mono text-sm font-medium uppercase transition-colors duration-300 hover:text-primary"
      >
        {contact.text}
        <ArrowRight class="text-primary size-5" stroke-width={1} />
      </a>
    </div>

    <!-- questions -->
    <div class="lg:col-span-2 border-b border-neutral-200">
      {
        faqs.map((faq, index) => (
          <details class="group border-t border-neutral-200" data-faq>
            <summary class="flex items-baseline gap-4 py-8 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden lg:gap-9">
              <span class="font-mono text-xs text-neutral-400">
                0{index + 1}
              </span>
              <span class="flex-1 text-xl transition-colors duration-300 group-hover:text-primary lg:text-2xl">
                {faq.question}
              </span>
              <Plus
                class="size-6 shrink-0 self-center transition-transform duration-300 group-open:rotate-45 group-open:text-primary"
                stroke-width={1}
              />
            </summary>
            <p class="pb-8 pl-8 pr-10 max-w-2xl text-neutral-600 lg:pl-13">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Solo una pregunta abierta a la vez
  document.querySelectorAll("[data-faq]").forEach((faq) => {
    faq.addEventListener("toggle", (e) => {
      const target = e.target as HTMLDetailsElement;
      if (target.open) {
        document.querySelectorAll("[data-faq]").forEach((other) => {
          if (other !== target && (other as HTMLDetailsElement).open) {
            (other as HTMLDetailsElement).open = false;
          }
        });
      }
    });
  });
</script>
