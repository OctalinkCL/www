---
// Nombres de clientes reales — logos placeholder vía placehold.co hasta tener los assets finales.
const clients = [
  { name: "Lomo Alemán", slug: "Lomo+Aleman" },
  { name: "Belprosur", slug: "Belprosur" },
  { name: "RHL Real Estate", slug: "RHL+Real+Estate" },
  { name: "Move Factory", slug: "Move+Factory" },
];

const logoUrl = (slug: string) =>
  `https://placehold.co/200x56/transparent/292420?text=${slug}&font=inter`;
---

<section class="bg-paper border-y border-black/6">
  <div class="wrapper py-10 md:py-12">
    <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-12">
      <span class="eyebrow text-ink-950/45 whitespace-nowrap">Trabajamos con</span>

      <div class="logo-marquee flex flex-wrap md:flex-nowrap items-center justify-between gap-x-10 gap-y-4 flex-1">
        {
          clients.map((client) => (
            <img
              src={logoUrl(client.slug)}
              alt={client.name}
              class="h-7 md:h-8 w-auto opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300"
              loading="lazy"
              width={200}
              height={56}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
