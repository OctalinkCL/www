---
import { ArrowRight } from "@lucide/astro";

const tag = "/ POR QUÉ OCTALINK";
const title = "Una agencia entrega un sitio.";
const subtitle = "Nosotros nos quedamos a cargo de que funcione.";
const cta = "Ver planes y precios";
const labels = {
  agency: "Agencia tradicional",
  us: "Octalink",
};
const items = [
  {
    topic: "Precio",
    agency: "Un pago grande por adelantado, y cada cambio aparte",
    us: "Valor mensual fijo desde $129.000, sin pago inicial",
  },
  {
    topic: "Relación",
    agency: "Hacen el sitio y desaparecen",
    us: "Estamos siempre — es nuestra responsabilidad",
  },
  {
    topic: "Servicios",
    agency: "Hosting, dominio y correo por separado",
    us: "Todo incluido en una sola suscripción",
  },
  {
    topic: "Soporte",
    agency: "Soporte por ticket o sin respuesta",
    us: "WhatsApp directo, con respuesta en menos de 24 o 48 h según tu plan",
  },
];
---

<section>
  <div class="container mx-auto px-5 py-24 lg:max-w-330 lg:px-8 min-[1400px]:px-0">
    <span class="font-mono text-neutral-500 text-xs uppercase" data-reveal>{tag}</span>
    <h2 class="text-4xl mt-3 max-w-5xl lg:text-5xl lg:mt-10" data-reveal>
      {title}
      <span class="text-neutral-500">{subtitle}</span>
    </h2>

    <!-- labels -->
    <div
      data-reveal
      class="hidden mt-16 pb-4 font-mono text-xs uppercase lg:grid lg:grid-cols-12 lg:gap-9"
    >
      <span class="col-start-4 col-span-4 text-neutral-500">
        {labels.agency}
      </span>
      <span class="col-span-5 flex items-center gap-2 font-medium">
        <span class="size-1.5 rounded-full bg-primary"></span>
        {labels.us}
      </span>
    </div>

    <ul class="mt-10 lg:mt-0">
      {
        items.map((item, index) => (
          <li class="border-t border-neutral-200 py-8 grid gap-4 lg:grid-cols-12 lg:gap-9 lg:py-10 lg:items-baseline" data-reveal>
            <!-- topic -->
            <div class="flex gap-4 font-mono text-xs uppercase lg:col-span-3">
              <span class="text-neutral-500">0{index + 1}</span>
              <span class="font-medium">{item.topic}</span>
            </div>
            <!-- agency -->
            <div class="lg:col-span-4">
              <span class="block mb-1 font-mono text-[10px] uppercase text-neutral-500 lg:hidden">
                {labels.agency}
              </span>
              <p class="text-neutral-500 line-through decoration-neutral-300">
                {item.agency}
              </p>
            </div>
            <!-- us -->
            <div class="lg:col-span-5">
              <span class="block mb-1 font-mono text-[10px] uppercase font-medium lg:hidden">
                {labels.us}
              </span>
              <p class="flex items-start gap-3 text-xl lg:text-2xl">
                <ArrowRight
                  class="text-primary size-6 shrink-0 mt-0.5 lg:mt-1"
                  stroke-width={1}
                />
                {item.us}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <a
      href="#planes"
      class="mt-10 inline-flex items-center gap-3 font-mono text-sm font-medium uppercase transition-colors duration-300 hover:text-primary"
    >
      {cta}
      <ArrowRight class="text-primary size-5" stroke-width={1} />
    </a>
  </div>
</section>
