---
import { ArrowRight } from "@lucide/astro";

const tag = "/ la diferencia";
const title = "Una agencia entrega un sitio.";
const subtitle = "Nosotros nos quedamos a cargo de que funcione.";
const labels = {
  agency: "Agencia tradicional",
  us: "Octalink",
};
const items = [
  {
    topic: "Precio",
    agency: "Cobro único de $400.000–$1.500.000",
    us: "Setup accesible + cuota mensual fija",
  },
  {
    topic: "Relación",
    agency: "Hacen el sitio y desaparecen",
    us: "Estamos siempre — es nuestra responsabilidad",
  },
  {
    topic: "Servicios",
    agency: "Hosting, dominio y correo por separado",
    us: "Todo incluido en una sola cuota",
  },
  {
    topic: "Soporte",
    agency: "Soporte por ticket o sin respuesta",
    us: "WhatsApp directo, respuesta garantizada",
  },
];
---

<section>
  <div class="container mx-auto px-4 py-24 lg:max-w-330 lg:px-0">
    <span class="font-mono text-neutral-400 text-xs uppercase">{tag}</span>
    <h3 class="text-4xl mt-3 max-w-5xl lg:text-5xl lg:mt-10">
      {title}
      <span class="text-neutral-400">{subtitle}</span>
    </h3>

    <!-- labels -->
    <div
      class="hidden mt-16 pb-4 font-mono text-xs uppercase lg:grid lg:grid-cols-12 lg:gap-9"
    >
      <span class="col-start-4 col-span-4 text-neutral-400">
        {labels.agency}
      </span>
      <span class="col-span-5 text-primary">{labels.us}</span>
    </div>

    <ul class="mt-10 lg:mt-0">
      {
        items.map((item, index) => (
          <li class="border-t border-neutral-200 py-8 grid gap-4 lg:grid-cols-12 lg:gap-9 lg:py-10 lg:items-baseline">
            <!-- topic -->
            <div class="flex gap-4 font-mono text-xs uppercase lg:col-span-3">
              <span class="text-neutral-400">0{index + 1}</span>
              <span class="font-medium">{item.topic}</span>
            </div>
            <!-- agency -->
            <div class="lg:col-span-4">
              <span class="block mb-1 font-mono text-[10px] uppercase text-neutral-400 lg:hidden">
                {labels.agency}
              </span>
              <p class="text-neutral-400 line-through decoration-neutral-300">
                {item.agency}
              </p>
            </div>
            <!-- us -->
            <div class="lg:col-span-5">
              <span class="block mb-1 font-mono text-[10px] uppercase text-primary lg:hidden">
                {labels.us}
              </span>
              <p class="flex items-start gap-3 text-xl lg:text-2xl">
                <ArrowRight
                  class="text-primary size-6 shrink-0 mt-0.5 lg:mt-1"
                  stroke-width={1}
                />
                {item.us}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
