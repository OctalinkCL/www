---
import { Check, ArrowRight } from "@lucide/astro";

const whatsappHref =
  "https://wa.me/56932393772?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20de%20Octalink.";

const trustSignals = [
  "Lanzamiento en 2-3 semanas",
  "Cuota fija sin sorpresas",
  "Sin contrato de permanencia",
  "Siempre respondemos",
];
---

<section class="relative overflow-hidden bg-ink-950">
  <!-- Resplandor sutil, sin orbes ni grid -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-130 opacity-40"
    style="background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(255, 94, 35, 0.18) 0%, transparent 70%);"
  >
  </div>

  <div class="wrapper relative z-10 pt-40 pb-20 md:pt-48 md:pb-28">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="section-title text-white mb-6 animate-fade-in-up">
        Tu equipo de tecnología,
        <br />
        <span class="text-accent">sin contratar un equipo de tecnología.</span>
      </h1>

      <p
        class="section-subtitle text-white/60 max-w-xl mx-auto mb-10 animate-fade-in-up"
        style="animation-delay: 0.1s;"
      >
        Web, correo, hosting y soporte — una cuota mensual fija. Nosotros respondemos
        siempre, tú te enfocas en vender.
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-14 animate-fade-in-up"
        style="animation-delay: 0.2s;"
      >
        <a href={whatsappHref} target="_blank" rel="noopener" class="btn-primary">
          <span>Hablar por WhatsApp</span>
          <ArrowRight size={18} />
        </a>
        <a href="#planes" class="btn-secondary">
          <span>Ver planes</span>
        </a>
      </div>

      <div
        class="flex flex-wrap justify-center gap-x-8 gap-y-3 pt-8 border-t border-white/10 animate-fade-in-up"
        style="animation-delay: 0.3s;"
      >
        {
          trustSignals.map((signal) => (
            <div class="flex items-center gap-2 text-sm text-white/50">
              <Check size={14} class="text-accent shrink-0" />
              <span>{signal}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
