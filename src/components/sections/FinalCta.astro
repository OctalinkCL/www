---
const tag = "¿Tienes un proyecto? ¿O solo una duda?";
const title = "Nosotros nos encargamos de la tecnología.";
const subtitle = "Tú de tu negocio.";
const note = "Llamada de 15 minutos — sin compromiso.";
const actions = {
  primary: {
    text: "Hablar por WhatsApp",
    href:
      "https://wa.me/56932393772?text=" +
      encodeURIComponent("Hola, quiero agendar una llamada de 15 minutos."),
  },
  secondary: {
    text: "hola@octalink.cl",
    href: "mailto:hola@octalink.cl",
  },
};
---

<section class="bg-white">
  <div class="container mx-auto px-4 pb-24 lg:max-w-330 lg:px-0">
    <div
      class="relative overflow-hidden rounded-3xl bg-neutral-900 text-white px-6 py-16 lg:px-20 lg:py-24"
    >
      <!-- glow -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-radial-[at_85%_135%] from-primary/80 via-primary/15 via-45% to-transparent to-75%"
      >
      </div>

      <div class="relative">
        <span class="font-mono text-xs uppercase">{tag}</span>
        <h3 class="text-4xl font-medium mt-6 max-w-4xl lg:text-7xl lg:mt-10">
          {title}
          <span class="text-neutral-500">{subtitle}</span>
        </h3>

        <div
          class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center lg:mt-16"
        >
          <a
            href={actions.primary.href}
            target="_blank"
            rel="noopener"
            class="btn btn-primary py-3"
          >
            {actions.primary.text}
          </a>
          <a href={actions.secondary.href} class="btn btn-white py-3">
            {actions.secondary.text}
          </a>
          <span class="text-neutral-400 sm:ml-5">{note}</span>
        </div>
      </div>
    </div>
  </div>
</section>
