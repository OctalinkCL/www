---
import {
  Package,
  Zap,
  RefreshCw,
  Receipt,
  LockOpen,
  ShieldCheck,
} from "@lucide/astro";

const tag = "nuestra promesa";
const title = "Lo que tu empresa espera de su web.";
const subtitle =
  "Que funcione, que acompañe el crecimiento del negocio y que deje de ser una preocupación.";
const figure = {
  src: "/assets/cover_mobile_o.webp",
  alt: "Equipo Octalink",
  name: "Equipo Octalink",
  role: "Tu infraestructura digital",
};
const benefits = [
  {
    icon: Package,
    title: "Todo incluido",
    description: "Web, hosting, dominio, correo y soporte en una sola cuota.",
  },
  {
    icon: Zap,
    title: "Soporte 24/7",
    description: "WhatsApp directo, todos los días y a toda hora.",
  },
  {
    icon: RefreshCw,
    title: "Actualización continua",
    description: "Tu web se actualiza cuando lo necesitas.",
  },
  {
    icon: Receipt,
    title: "Cuota fija",
    description: "Sin sorpresas, sin cobros extra inesperados.",
  },
  {
    icon: LockOpen,
    title: "Sin ataduras",
    description: "Sin contrato largo. 30 días de aviso y listo.",
  },
  {
    icon: ShieldCheck,
    title: "Estamos siempre",
    description: "A diferencia de una agencia tradicional, no desaparecemos.",
  },
];
---

<section id="beneficios" class="bg-neutral-900 text-white lg:scroll-mt-12">
  <div
    class="container grid gap-12 mx-auto px-5 py-24 lg:max-w-330 lg:px-8 min-[1400px]:px-0 lg:grid-cols-3 lg:gap-16"
  >
    <!-- figure -->
    <figure class="hidden lg:block">
      <img
        src={figure.src}
        alt={figure.alt}
        class="w-full aspect-4/5 object-cover rounded-3xl"
        loading="lazy"
        width={1080}
        height={1920}
      />
      <figcaption class="mt-6 flex flex-col gap-1">
        <span class="text-lg">{figure.name}</span>
        <span class="font-mono text-neutral-400 text-xs uppercase">
          / {figure.role}
        </span>
      </figcaption>
    </figure>

    <!-- content -->
    <div class="lg:col-span-2 flex flex-col gap-12 lg:gap-16">
      <div>
        <span class="font-mono text-neutral-400 text-xs uppercase">
          / {tag}
        </span>
        <h2 class="text-4xl font-medium mt-3 lg:text-5xl lg:mt-10">
          {title}
          <span class="text-neutral-500">{subtitle}</span>
        </h2>
      </div>

      <ul class="grid gap-y-10 sm:grid-cols-2 lg:grid-cols-3 lg:mt-auto">
        {
          benefits.map((benefit) => (
            <li class="border-l border-white/10 px-6 flex flex-col">
              <benefit.icon class="text-primary size-6" stroke-width={1} />
              <h3 class="text-lg mt-8 mb-2">{benefit.title}</h3>
              <p class="text-sm text-neutral-400">{benefit.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
